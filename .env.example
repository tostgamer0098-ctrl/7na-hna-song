# Copy this file to ".env" and fill in your real values. Never share this file or commit it anywhere public.

# Your Discord bot token (from the Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# The ID of the voice channel the bot should join to play music
VOICE_CHANNEL_ID=your_voice_channel_id_here

# The ID of the text/server the voice channel is in (right-click server icon -> Copy Server ID)
GUILD_ID=your_server_id_here

# Port for the web control panel (Replit/Railway set this automatically, you usually don't need to change it)
PORT=3000
